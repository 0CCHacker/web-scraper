# Vertex AI (Gemini 2.5 Flash)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-east5
# Paste the service-account JSON as a single line. The app writes it to /tmp and points GOOGLE_APPLICATION_CREDENTIALS at it.
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Upstash Redis (rate limit + robots.txt cache + schema cache)
# Optional locally: if unset, rate limit + caches become no-ops and you get a console warning.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
